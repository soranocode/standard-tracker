<UserControl x:Class="Hearthstone_Deck_Tracker.Windows.MainWindowControls.DeckChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hearthstone_Deck_Tracker.Windows.MainWindowControls"
             xmlns:converters="clr-namespace:Hearthstone_Deck_Tracker.Utility.Converters"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="360"
             Background="#121721" TextElement.FontFamily="Segoe UI">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Controls/StandardDesign.xaml"/></ResourceDictionary.MergedDictionaries>
        <converters:LocalizationConverter x:Key="LocalizationConverter" />
      </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.DataContext>
        <local:DeckChartsViewModel/>
    </UserControl.DataContext>
    <Grid>
        <DockPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Border DockPanel.Dock="Top" Background="#1C2533" CornerRadius="10" Padding="16" Margin="0">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Text="{Binding WinrateLabel}" FontSize="23" FontWeight="SemiBold" Foreground="#EDF2FA"/>
                            <TextBlock Text="Доля побед" FontSize="10" Foreground="#A3B0C4"/>
                        </StackPanel>
                        <StackPanel>
                          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="29">
                            <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="#EDF2FA">
                                <Run Text="{Binding Wins, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Losses, Mode=OneWay}"/>
                            </TextBlock>
                          </Viewbox>
                            <TextBlock Text="Победы / поражения" FontSize="10" Foreground="#A3B0C4" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalGames}" FontSize="23" FontWeight="SemiBold" Foreground="#EDF2FA"/>
                            <TextBlock Text="Игр" FontSize="10" Foreground="#A3B0C4"/>
                        </StackPanel>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding RecentResults}" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="4" CornerRadius="3" Margin="0,0,6,0" Background="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Последние матчи" FontSize="11" Foreground="#A3B0C4"/>
                        <TextBlock Text="Старые → новые" FontSize="11" Foreground="#A3B0C4" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid DockPanel.Dock="Top" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="#19212D" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Все" GroupName="HistoryFilter" Style="{StaticResource STFilter}" IsChecked="{Binding FilterAll}"/>
                        <RadioButton Content="Победы" GroupName="HistoryFilter" Style="{StaticResource STFilter}" IsChecked="{Binding FilterWins}"/>
                        <RadioButton Content="Поражения" GroupName="HistoryFilter" Style="{StaticResource STFilter}" IsChecked="{Binding FilterLosses}"/>
                    </StackPanel>
                </Border>
                <ComboBox Grid.Column="1" Width="98" Margin="6,0,0,0" VerticalAlignment="Center"
                          SelectedIndex="{Binding PeriodFilter, Mode=TwoWay}" Foreground="#EDF2FA" Background="#1C2533" BorderBrush="#3F5673">
                    <ComboBoxItem Content="Всё время"/><ComboBoxItem Content="7 дней"/><ComboBoxItem Content="Сегодня"/>
                </ComboBox>
            </Grid>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding ShownCountLabel}" FontSize="11" Foreground="#A3B0C4"/>
                <TextBlock Text="Новые сверху" FontSize="11" Foreground="#A3B0C4" HorizontalAlignment="Right"/>
            </DockPanel>

            <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <ItemsControl ItemsSource="{Binding DayGroups}">
                  <ItemsControl.ItemTemplate><DataTemplate><StackPanel>
                    <DockPanel Margin="0,0,8,10"><TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="#A3B0C4"/><TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="#8F9DB1" HorizontalAlignment="Right"/></DockPanel>
                <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,8">
                                <Expander Style="{StaticResource STMatch}">
                                  <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding ResultIconBackground}">
                                        <TextBlock Text="{Binding ResultGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{Binding ResultAccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding OpponentHero, Converter={StaticResource LocalizationConverter}}"
                                                   FontWeight="SemiBold" FontSize="14" Foreground="#EDF2FA" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#A3B0C4" Margin="0,3,0,0">
                                            <Run Text="{Binding Turns, Mode=OneWay}"/><Run Text=" ходов · "/><Run Text="{Binding SortableDuration, Mode=OneWay}"/><Run Text=" мин"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Result, Converter={StaticResource EnumDescriptionConverter}}"
                                                   FontWeight="Medium" HorizontalAlignment="Right" Foreground="{Binding ResultAccentBrush}"/>
                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:dd.MM · HH:mm}}" FontSize="10" Foreground="#A3B0C4" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                  </Expander.Header>
                                  <StackPanel Cursor="Arrow">
                                      <Border Height="1" Background="#34445A" Margin="0,0,0,12"/>
                                      <DockPanel Margin="0,0,0,6"><TextBlock Text="Ваш ранг" Foreground="#A3B0C4"/><TextBlock Text="{Binding RankString}" HorizontalAlignment="Right" Foreground="#EDF2FA"/></DockPanel>
                                      <DockPanel Margin="0,0,0,6"><TextBlock Text="Первый ход" Foreground="#A3B0C4"/><TextBlock HorizontalAlignment="Right" Foreground="#EDF2FA"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Вы"/><Style.Triggers><DataTrigger Binding="{Binding Coin}" Value="True"><Setter Property="Text" Value="Соперник"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
                                      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#A3B0C4" Margin="0,4,0,0"/>
                                  </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                  </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="За этот период таких матчей нет" Foreground="#A3B0C4" TextAlignment="Center" Margin="14,28"
                           Visibility="{Binding HasFilteredGames, Converter={StaticResource InverseBoolToVisibility}}"/>
              </Grid>
            </ScrollViewer>
        </DockPanel>
        <Grid Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" Margin="24">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Foreground="#EDF2FA"
                           Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}"
                           Text="{lex:Loc DeckCharts_Label_NoData}"/>
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#A3B0C4"
                           Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}"
                           Text="{lex:Loc DeckCharts_Label_PlaySomeGames}"/>
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Foreground="#EDF2FA"
                           Visibility="{Binding HasDeck, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Пока нет истории"/>
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="#A3B0C4" Margin="0,8,0,0"
                           Visibility="{Binding HasDeck, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Выберите колоду в библиотеке."/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
