<UserControl x:Class="Hearthstone_Deck_Tracker.Controls.SelectedDeckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hearthstone_Deck_Tracker"
             xmlns:controls1="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:controls="clr-namespace:Hearthstone_Deck_Tracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="320"
             Background="#121721" TextElement.FontFamily="Segoe UI" TextElement.Foreground="#EDF2FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EDF2FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3B0C4"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2533"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#79B4FF"/>
        <Style x:Key="DeckPill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#EDF2FA"/>
            <Setter Property="Background" Value="#1C2533"/>
            <Setter Property="BorderBrush" Value="#3F5673"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#395578"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#79B4FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#79B4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,16,14,0">
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="10" Background="{Binding ClassColorBrush}" DockPanel.Dock="Left" Margin="0,0,12,0">
                    <Image Source="{Binding ClassImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeckName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" ToolTip="{Binding DeckName}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border BorderBrush="#3F5673" Background="#29384E" BorderThickness="1" CornerRadius="7" Padding="7,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ClassName}" FontSize="11" Foreground="#B4C8E2"/>
                        </Border>
                        <TextBlock Text="{Binding FormatLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Border Margin="0,10,0,0" Padding="9,7" Background="#18212D" BorderBrush="#34445A" BorderThickness="1" CornerRadius="7"
                    Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding DeckCode}" FontSize="10" FontFamily="Consolas" Foreground="#8FA1BA" TextWrapping="Wrap"
                           ToolTip="{Binding DeckCode}"/>
            </Border>
            <Border Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12,14"
                    Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCards}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Карт" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding MinionCards}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Существ" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SpellCards}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Заклинаний" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
            <TextBox x:Name="SearchBox" Margin="0,12,0,0" MinHeight="38" Padding="12,8" FontSize="14"
                     Background="#1C2533" Foreground="#EDF2FA" CaretBrush="White" BorderBrush="#3F5673"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     controls1:TextBoxHelper.Watermark="Найти карту"
                     Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}"/>
            <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
                <ToggleButton Content="Все" Style="{StaticResource DeckPill}" Margin="0,0,8,0" IsChecked="{Binding FilterAll}"/>
                <ToggleButton Content="Существа" Style="{StaticResource DeckPill}" Margin="0,0,8,0" IsChecked="{Binding FilterMinions}"/>
                <ToggleButton Content="Заклинания" Style="{StaticResource DeckPill}" IsChecked="{Binding FilterSpells}"/>
            </WrapPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="6,0,6,8" Padding="12" Background="#1C2533" CornerRadius="9"
                Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Run Text="КРИВАЯ МАНЫ" FontSize="10" Foreground="#A3B0C4"/>
                    <Run Text="  ·  " Foreground="#A3B0C4"/>
                    <Run Text="Столбец — фильтр" FontSize="10" Foreground="#A3B0C4"/>
                </TextBlock>
                <local:ManaCurve x:Name="ManaCurveMyDecks" Height="110"/>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="14,0,14,8">
            <TextBlock Text="{Binding ShownLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Decoded via HearthDb" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
        </DockPanel>

        <Grid Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding VisibleCards}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasCards, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="14,0,14,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="#1C2533" BorderBrush="#30465F" BorderThickness="1" CornerRadius="4" Height="34">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A4568">
                                <TextBlock Text="{Binding Cost}" FontWeight="SemiBold" Foreground="#D7E8FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding LocalizedName}" FontWeight="SemiBold" Margin="10,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#EDF2FA"
                                       ToolTip="{Binding LocalizedName}"/>
                            <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#A3B0C4">
                                <Run Text="×"/><Run Text="{Binding Count, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                        Visibility="{Binding EmptyVisibility}">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Foreground="#EDF2FA"/>
                <TextBlock Text="{Binding EmptySubtitle}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                           Margin="0,12,0,0" Foreground="#A3B0C4"/>
            </StackPanel>
            <!-- Kept for callers that still look up ListViewDeck; hidden, unused for display -->
            <controls:AnimatedCardList x:Name="ListViewDeck" Width="0" Height="0" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
