<UserControl x:Class="Hearthstone_Deck_Tracker.Controls.SelectedDeckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hearthstone_Deck_Tracker"
             xmlns:controls1="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:controls="clr-namespace:Hearthstone_Deck_Tracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="320"
             Background="#121721" TextElement.FontFamily="Segoe UI" TextElement.Foreground="#EDF2FA">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Controls/StandardDesign.xaml"/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="TextBrush" Color="#EDF2FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3B0C4"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2533"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#79B4FF"/>
      </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,0" Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="10" Background="#1C2533" DockPanel.Dock="Left" Margin="0,0,12,0">
                    <Image Source="{Binding ClassImage}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeckName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" ToolTip="{Binding DeckName}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="Transparent" Padding="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ClassName}" FontSize="11" Foreground="#B4C8E2"/>
                        </Border>
                        <TextBlock Text="{Binding FormatLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Border Margin="0,10,0,0" Padding="0"
                    Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding DeckCode}" FontSize="10" FontFamily="Consolas" Foreground="#8FA1BA" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DeckCode}"/>
            </Border>
            <Border Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="12,9"
                    Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCards}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Карт" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding MinionCards}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Существ" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SpellCards}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Заклинаний" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
            <TextBox x:Name="SearchBox" Margin="0,12,0,0" Style="{StaticResource STSearch}" Tag="Найти карту"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     controls1:TextBoxHelper.Watermark="Найти карту"
                     Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}"/>
            <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasDeck, Converter={StaticResource BoolToVisibility}}">
                <RadioButton Content="Все" GroupName="CardType" Style="{StaticResource STFilter}" Margin="0,0,4,0" IsChecked="{Binding FilterAll}"/>
                <RadioButton Content="Существа" GroupName="CardType" Style="{StaticResource STFilter}" Margin="0,0,4,0" IsChecked="{Binding FilterMinions}"/>
                <RadioButton Content="Заклинания" GroupName="CardType" Style="{StaticResource STFilter}" IsChecked="{Binding FilterSpells}"/>
            </WrapPanel>
        </StackPanel>

        <Border x:Name="ManaCurveContainer" DockPanel.Dock="Bottom" Margin="16,0,16,16" Padding="12" Background="#1C2533" CornerRadius="9"
                Visibility="{Binding Visibility, ElementName=ManaCurveMyDecks}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Run Text="КРИВАЯ МАНЫ" FontSize="10" Foreground="#A3B0C4"/>
                </TextBlock>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ManaCounts}" Margin="0,0,0,5">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="10" Foreground="#A3B0C4" HorizontalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <local:ManaCurve x:Name="ManaCurveMyDecks" Height="64" Width="Auto"/>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,0,16,10">
            <TextBlock Text="{Binding ShownLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>

        <Grid Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding VisibleCards}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasCards, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="16,0,8,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="CardSurface" Background="#1C2533" BorderBrush="#30465F" BorderThickness="1" CornerRadius="4" Height="34">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#52769E"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="#263B56"/><Setter TargetName="CardSurface" Property="BorderBrush" Value="#79B4FF"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A4568">
                                <TextBlock Text="{Binding Cost}" FontWeight="SemiBold" Foreground="#D7E8FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding LocalizedName}" FontWeight="SemiBold" Margin="10,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#EDF2FA"
                                       ToolTip="{Binding LocalizedName}"/>
                            <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#A3B0C4">
                                <Run Text="×"/><Run Text="{Binding Count, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                        Visibility="{Binding EmptyVisibility}">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="#EDF2FA"/>
                <TextBlock Text="{Binding EmptySubtitle}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                           Margin="0,12,0,0" Foreground="#A3B0C4"/>
            </StackPanel>
            <!-- Kept for callers that still look up ListViewDeck; hidden, unused for display -->
            <controls:AnimatedCardList x:Name="ListViewDeck" Width="0" Height="0" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
